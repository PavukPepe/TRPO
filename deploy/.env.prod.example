# =====================================================================
# Production .env для docker-compose (deploy/docker-compose.prod.yml)
# Скопируйте в .env.prod, заполните реальными значениями.
# Файл .env.prod в .gitignore — секреты НЕ коммитим.
# =====================================================================

# --- Django ---
DEBUG=0
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=GENERATE_NEW_SECRET_HERE
# Заменить на реальный IP сервера или домен
ALLOWED_HOSTS=1.2.3.4,localhost
# Для CSRF в админке — полные origin-ы (http://1.2.3.4 или https://example.com)
CSRF_TRUSTED_ORIGINS=http://1.2.3.4

# --- БД (значения должны совпадать в db + web сервисах) ---
DB_NAME=multichat
DB_USER=multichat_user
DB_PASSWORD=GENERATE_STRONG_DB_PASSWORD
DB_HOST=db
DB_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- CORS — origin-ы, с которых ходит фронт (без слеша на конце) ---
CORS_ALLOWED_ORIGINS=http://1.2.3.4

# --- Системная почта (можно перенести значения из dev .env) ---
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Внешний URL фронтенда — для ссылок в email-приглашениях ---
FRONTEND_URL=http://1.2.3.4

# --- Сроки токенов ---
INVITE_TOKEN_EXPIRE_HOURS=48
RESET_TOKEN_EXPIRE_HOURS=1

# =====================================================================
# Параметры для сервиса frontend (build-args в docker-compose.prod.yml)
# =====================================================================
# Должен совпадать с тем, как пользователи открывают сайт.
# Если ходим через nginx с того же origin — оставить пустым.
NEXT_PUBLIC_API_URL=

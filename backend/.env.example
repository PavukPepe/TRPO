# =====================================================================
# MultiChat Hub — Backend ENV (шаблон)
# Скопируйте файл в .env и заполните реальными значениями.
# В production все секреты должны быть сгенерированы заново.
# =====================================================================

# --- Django ---
# DEBUG=0 в production, DEBUG=1 в разработке
DEBUG=0
# Сгенерировать новый: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-new-secret-key
# Хосты, на которых работает приложение (через запятую, без http://)
ALLOWED_HOSTS=example.com,www.example.com,1.2.3.4
# Источники, которым доверяем для CSRF (полные URL с http(s)://)
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# --- База данных PostgreSQL ---
DB_NAME=multichat
DB_USER=multichat_user
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# --- Redis (брокер Celery + Channels) ---
REDIS_URL=redis://redis:6379/0

# --- CORS (через запятую, полные URL с http(s)://) ---
CORS_ALLOWED_ORIGINS=https://example.com

# --- Системная почта (для приглашений, сброса пароля, уведомлений) ---
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Внешний URL фронтенда (используется в ссылках в email) ---
FRONTEND_URL=https://example.com

# --- Сроки жизни токенов приглашения/сброса пароля (часы) ---
INVITE_TOKEN_EXPIRE_HOURS=48
RESET_TOKEN_EXPIRE_HOURS=1

%% Контекст и инфраструктура
class AppDbContext {
  +AuditLogs : DbSet<AuditLog>
  +Brands : DbSet<Brand>
  +DeliveredOrders : DbSet<DeliveredOrder>
  +Materials : DbSet<Material>
  +Orders : DbSet<Order>
  +OrderDetails : DbSet<OrderDetail>
  +OrderStatuses : DbSet<OrderStatus>
  +PaymentStatuses : DbSet<PaymentStatus>
  +Products : DbSet<Product>
  +Roles : DbSet<Role>
  +Users : DbSet<User>
  +ProductInventoryView : DbSet<ProductInventoryView>
  +UserOrdersSummaryView : DbSet<UserOrdersSummaryView>
  +BrandSalesAnalyticsView : DbSet<BrandSalesAnalyticsView>
  +UserPreferences : DbSet<UserPreference>
  +PasswordResetTokens : DbSet<PasswordResetToken>
  +TelegramVerificationTokens : DbSet<TelegramVerificationToken>
  +PendingRegistrations : DbSet<PendingRegistration>
  +OnModelCreating(modelBuilder)
}
class Program {
  +builder : WebApplicationBuilder
  +app : WebApplication
  +ConfigureLogging()
  +ConfigureServices()
  +ConfigurePipeline()
}
class ExceptionMiddleware {
  -next : RequestDelegate
  -logger : ILogger
  +InvokeAsync(context)
  -HandleExceptionAsync(context, exception)
}
class ShopMetrics {
  <<static>>
  +ActiveUsers : Gauge
  +OrdersTotal : Gauge
  +OrdersByStatus : Gauge
  +ProductsInStock : Gauge
}
class ShopMetricsCollector {
  -_scopeFactory : IServiceScopeFactory
  -_logger : ILogger
  -_interval : TimeSpan
  +ExecuteAsync(stoppingToken)
  -CollectSnapshot(token)
}
class IDatabaseDumpService {
  <<interface>>
  +CreateDumpAsync(token)
  +RestoreDumpAsync(stream, token)
}
class DatabaseDumpOptions {
  +PgDumpPath : string
  +PsqlPath : string
}
class DatabaseDumpService {
  -_contextFactory : IDbContextFactory<AppDbContext>
  -_logger : ILogger
  -_pgDumpPath : string
  -_psqlPath : string
  +CreateDumpAsync(token)
  +RestoreDumpAsync(stream, token)
}
class ITelegramMessenger {
  <<interface>>
  +SendVerificationMessageAsync(chatId, code, token)
  +SendPasswordResetTokenAsync(chatId, token, cancellationToken)
}
class TelegramOptions {
  +BotToken : string
  +VerificationTemplate : string
  +PasswordResetTemplate : string
}
class TelegramMessenger {
  -_httpClient : HttpClient
  -_options : TelegramOptions
  +SendVerificationMessageAsync(chatId, code, token)
  +SendPasswordResetTokenAsync(chatId, token, cancellationToken)
  -SendMessageAsync(chatId, text, token)
}
class RegistrationOptions {
  +BotSecret : string
  +DefaultRoleName : string
  +VerificationCodeTtlMinutes : int
}


erDiagram
    Пользователь {
        string Email "уникальный"
        string Имя
        string Фамилия
        enum Роль "admin · rop · manager"
        string Организация
        bool Активен
        datetime ДатаСоздания
    }

    Сайт {
        string Название
        string URL
        uuid UUID "публичный идентификатор"
        json НастройкиВиджета
        json РабочиеЧасы
        bool АвтоответВключён
        text СообщениеАвтоответа
        string TelegramТокен
        string РеферальныйКод
        datetime ДатаСоздания
    }

    Заявка {
        string ИмяКлиента
        string EmailКлиента
        string TelegramНик
        bigint TelegramUserID
        bigint TelegramChatID
        enum Статус "new · in_progress · replied · closed"
        enum Канал "widget · telegram"
        datetime ДатаСоздания
        datetime ДатаОбновления
        datetime ДатаЗакрытия
    }

    Сообщение {
        enum ТипОтправителя "client · manager · system"
        text Содержание
        datetime ВремяОтправки
    }

    Файл {
        string ПутьКФайлу
        string ИмяФайла
        int РазмерБайт
        string MIMEТип
        datetime ДатаЗагрузки
    }

    Оценка {
        smallint Балл "от 1 до 5"
        text Комментарий
        datetime ДатаОценки
    }

    ШаблонОтвета {
        string Название
        text Содержание
        string ГорячаяКлавиша
        datetime ДатаСоздания
    }

    ОчередьМенеджеров {
        int ПозицияВОчереди
        bool АктивенВОчереди
    }

    СтатусМенеджера {
        enum Статус "online · away · offline"
        datetime ВремяИзменения
    }

    TelegramПользователь {
        bigint TelegramID "уникальный"
        string Username
        string Имя
        string Фамилия
        datetime ДатаСоздания
    }

    Пользователь ||--o{ Сайт : "владеет"
    Пользователь |o--o{ Заявка : "обрабатывает"
    Пользователь |o--o{ Сообщение : "отправляет"
    Пользователь ||--o{ Оценка : "получает"
    Пользователь |o--o{ ШаблонОтвета : "создаёт"
    Пользователь ||--|| СтатусМенеджера : "имеет"
    Пользователь ||--o{ ОчередьМенеджеров : "владеет очередью"
    Пользователь ||--o{ ОчередьМенеджеров : "участвует в очереди"
    Сайт ||--o{ Заявка : "содержит"
    Заявка ||--o{ Сообщение : "содержит"
    Заявка ||--o| Оценка : "получает"
    Сообщение ||--o{ Файл : "содержит"

    API --> OrdersSvc["Orders & Delivery"]
    OrdersSvc --> Delivery["Delivery scheduling"]
    OrdersSvc --> Payments["Payment processing"]
    API --> AnalyticsSvc["Analytics / Reports / Views"]
    API --> BackupSvc["Database backup/restore"]
    API --> AuditSvc["Audit log / Activity"]
    API --> WidgetSvc["Widget endpoint (public)"]
    API --> SitesSvc["Public sites management"]
    API --> StatsSvc["Stats endpoints"]
    API --> ChatsSvc["Chat APIs"]

    %% CI / Preview
    GitLabCI["CI / GitLab pipeline"] -->|build| Image["Docker image / artifacts"]

%% ═══════════════════════ Доменные модели ═══════════════════════

class User {
  +id : int
  +email : str
  +password : str
  +first_name : str
  +last_name : str
  +role : str
  +organization_name : str
  +is_superuser : bool
  +is_staff : bool
  +is_active : bool
  +last_login : datetime?
  +date_joined : datetime
  +created_at : datetime
  +__str__() str
  +is_admin() bool
  +is_rop() bool
  +is_manager() bool
}

class Site {
  +id : int
  +name : str
  +url : str
  +site_uuid : UUID
  +widget_settings : dict
  +working_hours : dict
  +auto_reply_enabled : bool
  +auto_reply_message : str
  +telegram_bot_token : str
  +telegram_referral_code : str
  +created_at : datetime
  +owner : FK(User)
  +__str__() str
  +is_working_now() bool
}

class Chat {
  +id : int
  +client_name : str
  +client_email : str
  +telegram_username : str
  +status : str
  +channel : str
  +created_at : datetime
  +updated_at : datetime
  +closed_at : datetime?
  +site : FK(Site)
  +assigned_manager : FK(User)?
  +telegram_user_id : int?
  +telegram_chat_id : int?
  +__str__() str
}

class Message {
  +id : int
  +sender_type : str
  +content : str
  +timestamp : datetime
  +chat : FK(Chat)
  +sender : FK(User)?
  +__str__() str
}

class File {
  +id : int
  +file : str
  +filename : str
  +file_size : int
  +mime_type : str
  +uploaded_at : datetime
  +message : FK(Message)
}

class Rating {
  +id : int
  +rating : int
  +comment : str
  +created_at : datetime
  +chat : OneToOne(Chat)
  +manager : FK(User)
}

class Template {
  +id : int
  +title : str
  +content : str
  +hotkey : str
  +created_at : datetime
  +user : FK(User)?
  +__str__() str
}

class ManagerQueue {
  +id : int
  +position : int
  +is_active : bool
  +manager : FK(User)
  +owner : FK(User)
}

class ManagerStatus {
  +id : int
  +status : str
  +changed_at : datetime
  +manager : OneToOne(User)
}

class TelegramUser {
  +id : int
  +telegram_id : int
  +username : str
  +first_name : str
  +last_name : str
  +created_at : datetime
  +__str__() str
}

%% ═══════════════════════ Инфраструктура ═══════════════════════

class ChatConsumer {
  -channel_layer : RedisChannelLayer
  -room_group_name : str
  +connect()
  +disconnect(close_code)
  +receive_json(content)
  +chat_message(event)
  +typing_indicator(event)
  +status_changed(event)
  +save_message(chat, content, sender) Message
}

class NotificationConsumer {
  -channel_layer : RedisChannelLayer
  -group_name : str
  +connect()
  +disconnect(close_code)
  +receive_json(content)
  +new_chat(event)
  +chat_assigned(event)
  +new_message(event)
  +chat_reassigned(event)
}

class NotificationService {
  +notify_new_chat(chat) None
  +notify_new_message(message) None
  +notify_chat_status_changed(chat) None
  +notify_chat_assigned(chat) None
  +get_layer() ChannelLayer
}

class TelegramBotHandler {
  -site : Site
  -bot_token : str
  +handle_update(update) None
  +send_message(chat_id, text) bool
  +send_file(chat_id, file) bool
  +send_rating_request(chat_id) bool
}

class CeleryTasks {
  <<static>>
  +check_chat_response_timeout(chat_id) None
  +assign_chat_to_next_manager(chat_id) None
  +update_manager_statuses() None
  +process_telegram_update(site_id, update) None
  +send_telegram_reply(chat_id, text) None
  +send_rating_request(chat_id) None
  +handle_rating_callback(site_id, callback) None
}

%% ═══════════════════════ Разрешения ═══════════════════════

class IsManager {
  +message : str
  +has_permission(request, view) bool
}

class IsROP {
  +message : str
  +has_permission(request, view) bool
}

class IsAdmin {
  +message : str
  +has_permission(request, view) bool
}


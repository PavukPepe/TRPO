%% Level 3: поля/props (без методов, без связей) — ключевые элементы
classDiagram
direction TB

class Layout {
  +children : ReactNode
  +metadata : object
  +headerVisible : bool
  +sidebarCollapsed : bool
}
class AuthGuard {
  +children : ReactNode
  +allowedRoles : string[]
  +redirectTo : string
  +loading : bool
}
class AppHeader {
  +user : User | null
  +onToggleSidebar() : void
  +notificationsCount : int
}
class AppSidebar {
  +items : MenuItem[]
  +collapsed : bool
  +activeRoute : string
}
class NotificationProvider {
  +notifications : Notification[]
  +addNotification() : void
  +removeNotification() : void
}
class ThemeProvider {
  +theme : "light"|"dark"
  +toggleTheme() : void
}
class DashboardPage {
  +topCardsData : object
  +recentOrders : Order[]
  +chartsData : object
}
class OrdersPage {
  +filters : object
  +orders : Order[]
  +loading : bool
}
class ApiClient {
  +get(url:string, params?:object) : Promise<any>
  +post(url:string, body?:object) : Promise<any>
}
class useMobile {
  +isMobile : bool
}
class useToast {
  +showToast(message:string, type?:string) : void
}

